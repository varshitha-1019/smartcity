# Copy this file to .env and fill in real values. Never commit the real .env file.

# Port the Express server listens on. If you change this, also update
# VITE_API_URL in frontend/.env to point at the same port.
PORT=5000

# MongoDB connection string. If omitted, the backend automatically starts a
# local MongoDB instance (via mongodb-memory-server) and stores its data in
# backend/.devDb/ (gitignored) - no local MongoDB install required, and
# data now persists across server restarts (see backend/config/db.js).
# Set a real MongoDB URI here for a shared, network-accessible, or
# production database instead.
MONGODB_URI=your_mongodb_connection_string

# Secret used to sign and verify JWTs. Required for any non-throwaway use -
# the server will start without it in development (falling back to an
# insecure, publicly known default and printing a warning), but you should
# always set a real, unique value outside of quick local experiments. For
# example, generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-development-secret

# Comma-separated list of allowed CORS origins for the frontend
# (see backend/server.js). Defaults to allowing all origins if unset.
FRONTEND_URL=http://localhost:5173

# Absolute path to the Python interpreter containing numpy, Pillow, and
# TensorFlow. On Windows, use the Python 3.12 AI environment, for example:
# PYTHON_PATH=C:\smartcity-ai-venv\Scripts\python.exe
PYTHON_PATH=

# Set to "production" in any real deployment. When set, the server refuses
# to start if JWT_SECRET is missing, instead of falling back to the
# insecure development default. Leave unset for local development.
NODE_ENV=development

# Maximum allowed distance, in meters, between the citizen's original issue
# coordinates and the authority's resolution-evidence coordinates before the
# resolution is flagged with an "outside the original issue location"
# warning (see backend/services/gpsService.js: verifyResolutionLocation).
# This never causes either coordinate pair to be replaced/adjusted - both
# stay authentic; it only controls when the warning is shown. Defaults to
# 500 meters if unset.
ALLOWED_RESOLUTION_RADIUS_METERS=500
